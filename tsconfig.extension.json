{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Node",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "extension",
    "outDir": "extension/dist",
    "noEmitOnError": true
  },
  "include": ["extension/**/*.ts"]
}
