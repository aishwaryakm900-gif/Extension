{
  "manifest_version": 3,
  "name": "Reader AI",
  "version": "0.1.0",
  "description": "Understand unfamiliar language in the context where you found it.",
  "permissions": [],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Reader AI",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["dist/pdf.worker.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
